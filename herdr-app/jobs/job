#!/usr/bin/env python3
"""job - scheduled agent jobs and hooks for this machine, run as Herdr sessions.

Each machine lists its own job sources in herdr-app/machines/<machine>.toml
([jobs] sources), so work jobs live on the work Mac and personal jobs on
Omarchy, and neither machine sees the other's.

A source folder holds TOML files of two kinds:

  job   repo, agent, prompt or prompt_file, optional [schedule], space (default
        "Jobs", created when missing) and tab.
        require_visible = true requires an open app and an existing local space.
        `job run <name>` starts one interactive agent under herdr-core (hc), so
        it shows in the Herdr app and phone inbox and can take another turn.
  hook  check = "<script>" and interval = <seconds>. The script answers
        `check` (do the work now) and `status` (JSON: {ok, hooks: [{last_check,
        last_trigger}]}). The engine schedules `check` every interval.

Scheduling uses launchd on macOS and systemd user timers on Linux. Nothing here
is a daemon: the scheduler fires `job run` or `job check`.

  job list                  every job and hook, its kind and schedule
  job status                every job and hook as JSON for the Jobs panel
  job run <name> [--wait]   start a job now (--wait: block until it stops working;
                            close_when_done = true in the job also exits it after an ok run)
  job check <hook>          run a hook's check now
  job pause | resume        stop or restart scheduled jobs and hooks (for demos);
                            a run started by hand (--force) still goes.
                            --by <who> tags the pause; resume --by <who> only lifts a
                            pause that <who> made (the Demo layout uses --by demo)
  job unit <name>           print the launchd plist or systemd units for its schedule
  job install <name>        write and load that schedule
  job uninstall <name>      unload and remove it
  job refresh [--check]     rewrite the schedule of every job and hook that's turned on,
                            so it runs this engine; list schedules with no definition here
"""
import argparse, json, os, plistlib, re, shutil, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
import machine  # noqa: E402

machine.need_tomllib()
import tomllib  # noqa: E402

HOME = Path.home()
LINUX = sys.platform.startswith("linux")
# Scheduled runs don't load the shell, so name where hc, herdr-app and the agents live.
if LINUX:
    PATH = f"{HOME}/.local/bin:{HOME}/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
else:
    PATH = f"{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
PATH = os.environ.get("JOB_PATH", PATH)  # tests point this at fake hc and herdr-app
# Codex only sees Herdr when it runs its shell commands in-process.
AGENTS = {"claude": ["claude"], "codex": ["codex", "--no-daemon"]}
STATE = Path(os.environ.get("JOB_STATE_DIR", HOME / ".local/state/parker-jobs"))
RUNS = STATE / "runs.jsonl"
# While this file exists, scheduled job runs and hook checks skip.
PAUSED = STATE / "paused"
LAUNCHD = Path(os.environ.get("JOB_LAUNCHD_DIR", HOME / "Library/LaunchAgents"))
SYSTEMD = Path(os.environ.get("JOB_SYSTEMD_DIR", HOME / ".config/systemd/user"))
# Tests and dry runs set this to "none" so nothing is loaded into the real scheduler.
SCHEDULER = os.environ.get("JOB_SCHEDULER") or ("systemd" if LINUX else "launchd")


class DefError(Exception):
    """A job or hook file that can't be used. The CLI prints it; status shows it on the item's row."""


class ScheduleError(Exception):
    """launchd or systemd refused a schedule."""


# Names defined in more than one source: {name: why}. Each shows as a broken item.
DUPLICATES = {}


def die(msg):
    sys.exit(f"job: {msg}")


# ---- definitions ----------------------------------------------------------

def sources():
    """This machine's job folders. $JOB_DEFS (colon-separated) overrides the manifest."""
    env = os.environ.get("JOB_DEFS")
    if env:
        return [Path(p) for p in env.split(os.pathsep) if p]
    return [machine.expand(p) for p in machine.manifest().get("jobs", {}).get("sources", [])]


def definitions():
    """{name: path} for every job and hook file in this machine's sources."""
    found = {}
    for folder in sources():
        if not folder.is_dir():
            continue
        for path in sorted(folder.glob("*.toml")):
            if path.stem in found:
                DUPLICATES[path.stem] = f"'{path.stem}' is defined twice: {found[path.stem]} and {path}"
                continue
            found[path.stem] = path
    return found


def raw(name):
    """The parsed file, with name, path and kind, before any checks."""
    path = definitions().get(name)
    if not path:
        raise DefError(f"no job or hook '{name}' on this machine ({', '.join(map(str, sources())) or 'no sources'})")
    try:
        item = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise DefError(f"{name}: can't read {path}: {exc}") from None
    item["name"], item["path"] = name, path
    item["kind"] = "hook" if "check" in item else "job"
    return item


def load(name):
    """A definition, checked. Anything wrong with it raises DefError naming the problem."""
    item = raw(name)
    if name in DUPLICATES:
        raise DefError(DUPLICATES[name])
    try:
        return checked(item)
    except DefError:
        raise
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as exc:
        raise DefError(f"{name}: {type(exc).__name__}: {exc}") from None


def checked(item):
    name, path = item["name"], item["path"]
    if item["kind"] == "hook":
        item["script"] = (path.parent / item["check"]).resolve()
        if not item["script"].exists():
            raise DefError(f"{name}: check script {item['script']} is missing")
        if int(item.get("interval", 0)) < 60:
            raise DefError(f"{name}: a hook needs interval = <seconds>, at least 60")
        item["interval"] = int(item["interval"])
        return item
    item["repo"] = str(machine.expand(item.get("repo", "")).resolve())
    if not Path(item["repo"]).is_dir():
        raise DefError(f"{name}: repo {item['repo']} is not a folder")
    if item.get("agent") not in AGENTS:
        raise DefError(f"{name}: agent must be one of {', '.join(AGENTS)}")
    if "prompt_file" in item:
        item["prompt"] = (path.parent / item["prompt_file"]).read_text()
    if not item.get("prompt", "").strip():
        raise DefError(f"{name}: needs prompt or prompt_file")
    sched = item.get("schedule")
    if sched is not None:
        for t in times_of(sched):
            if not re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", t):
                raise DefError(f"{name}: schedule time '{t}' must be HH:MM")
        if any(d not in range(1, 8) for d in sched.get("weekdays") or []):
            raise DefError(f"{name}: weekdays are 1 (Monday) to 7 (Sunday)")
    return item


def all_items():
    """Every definition, loaded; one that can't be used comes back as {name, kind, error}."""
    items = []
    for name in definitions():
        try:
            items.append(load(name))
        except DefError as exc:
            kind = "job"
            try:
                kind = raw(name)["kind"]
            except DefError:
                pass
            items.append({"name": name, "kind": kind, "error": str(exc)})
    return items


# ---- Herdr ----------------------------------------------------------------

def clean_env():
    """A scheduled agent must not inherit another agent's session settings."""
    keep = ("HOME", "USER", "LOGNAME", "SHELL", "LANG", "TMPDIR", "HC_SESSION", "SSH_AUTH_SOCK",
            "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "WAYLAND_DISPLAY", "DISPLAY", "PARKER_MACHINE")
    env = {k: os.environ[k] for k in keep if k in os.environ}
    env["PATH"] = PATH
    return env


def hc(*args, check=True):
    out = subprocess.run(["hc", args[0], "--json", *args[1:]], capture_output=True, text=True, env=clean_env())
    if check and out.returncode != 0:
        die(f"hc {args[0]} failed: {out.stderr.strip() or out.stdout.strip()}")
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return {}


def herdr_spaces():
    if not shutil.which("herdr-app", path=PATH):
        return None
    out = subprocess.run(["herdr-app", "ls"], capture_output=True, text=True, env=clean_env())
    if out.returncode != 0:
        return None
    try:
        spaces = json.loads(out.stdout).get("spaces")
        return spaces if isinstance(spaces, list) else None
    except (json.JSONDecodeError, AttributeError):
        return None


def herdr_do(command, args):
    out = subprocess.run(["herdr-app", "do", command, json.dumps(args)], capture_output=True, text=True, env=clean_env())
    try:
        return json.loads(out.stdout) if out.returncode == 0 else {}
    except json.JSONDecodeError:
        return {}


def ensure_space(name, folder):
    """(space id, placeholder tab id) for the Herdr space a job's session goes in.

    A session that isn't placed in a space runs where no one can see it, including
    any first-run question it asks. A missing space is created; Herdr opens it with
    a shell tab, which the caller closes once the session has joined. (None, None)
    when the Herdr window isn't open."""
    spaces = herdr_spaces()
    if spaces is None:
        return None, None
    found = next((s["id"] for s in spaces if s.get("name") == name and not s.get("machine")), None)
    if found:
        return found, None
    made = herdr_do("space.new", {"name": name, "folder": folder, "focus": False})
    return made.get("space"), made.get("tab")


def name_tab(addr, name):
    """Name the Herdr tab that holds addr. Herdr otherwise calls it by its number."""
    for _ in range(10):  # the pane can take a moment to show up
        spaces = herdr_spaces()
        if spaces is None:
            return
        for space in spaces:
            for tab in space.get("tabs", []):
                if addr in [t.get("terminal") for t in tab.get("terminals", [])]:
                    subprocess.run(["herdr-app", "do", "tab.rename", "--id", tab["id"], "--name", name],
                                   capture_output=True, text=True, env=clean_env())
                    return
        time.sleep(1)


# ---- pause ----------------------------------------------------------------

def paused():
    """{"ts": epoch, "by"?: who} when jobs are paused, else None."""
    try:
        return json.loads(PAUSED.read_text())
    except (OSError, ValueError):
        return {"ts": int(PAUSED.stat().st_mtime)} if PAUSED.exists() else None


# ---- run a job ------------------------------------------------------------

def start_visible(job, prompt):
    space_name = job.get("space") or "Jobs"
    spaces = herdr_spaces()
    if spaces is None:
        die(f"{job['name']}: Herdr app unavailable; no agent started")
    space = next((s["id"] for s in spaces if s.get("name") == space_name and not s.get("machine")), None)
    if not space:
        die(f"{job['name']}: local Herdr space '{space_name}' unavailable; no agent started")

    # Let the app create the visible tab. Keep the task out of argv and the tab
    # creation request so Codex cannot receive it before placement is verified.
    tab_name = job.get("tab") or job["name"].replace("-", " ").capitalize()
    made = herdr_do("tab.new", {"space": space, "name": tab_name, "folder": job["repo"],
                                "argv": AGENTS[job["agent"]], "focus": False})
    addr = made.get("terminal")
    if not addr:
        die(f"{job['name']}: Herdr did not confirm tab creation; prompt withheld")

    hc("wait", addr, "--timeout", "30", check=False)
    info = hc("get", addr, check=False)
    tabs = (t for s in herdr_spaces() or []
            if s.get("id") == space and s.get("name") == space_name and not s.get("machine")
            for t in s.get("tabs", []))
    if not any(t.get("name") == tab_name
               and any(p.get("terminal") == addr for p in t.get("terminals", [])) for t in tabs):
        hc("kill", addr)
        die(f"{job['name']}: could not verify placement in '{space_name}' / '{tab_name}'; prompt withheld")

    record(job["name"], addr, addr)
    if info.get("state") != "live" or (info.get("status") or {}).get("state") != "idle":
        die(f"{job['name']}: agent did not become idle in '{tab_name}' ({addr}); prompt withheld")
    hc("send", "--if", "idle", addr, prompt)
    return addr


def run(args):
    job = load(args.name)
    if job["kind"] != "job":
        die(f"{job['name']} is a hook; use `job check {job['name']}`")
    if paused() and not args.force:
        print(json.dumps({"session": None, "started": False, "paused": True,
                          "why": f"jobs are paused; {job['name']} skipped (job resume, or run it with --force)"}))
        return
    session = f"{job['name']}-{time.strftime('%m%d-%H%M')}"[:32]
    require_visible = job.get("require_visible") is True
    prompt = job["prompt"]
    close = bool(job.get("close_when_done"))
    if close:
        outcome = outcome_file(job["name"])
        outcome.parent.mkdir(parents=True, exist_ok=True)
        outcome.unlink(missing_ok=True)
        prompt += ("\n\n## Closing this session\n\n"
                   f"As your very last step, write one line to `{outcome}`: `ok: <what changed, or no changes>` "
                   "when the run finished, or `blocked: <why>` when something stopped it. "
                   "After `ok`, the job runner exits this session; after `blocked`, or no file, it stays open for me.\n")
    if require_visible:
        addr = session = start_visible(job, prompt)
    else:
        # A manually started job can outlive its parent terminal.
        parent = os.environ.get("HC_TERMINAL_ID")
        family = ["--parent", parent, "--outlive-parent"] if parent else ["--no-parent"]
        cmd = ["run", "--bg", *family, "--name", session, "--cwd", job["repo"], "--label", f"job={job['name']}"]
        space, placeholder = ensure_space(job.get("space") or "Jobs", job["repo"])
        if space:
            cmd += ["--label", f"herdr.space={space}"]
        started = hc(*cmd, *AGENTS[job["agent"]], prompt)
        addr = started.get("address", session)
        if placeholder:
            herdr_do("tab.close", {"id": placeholder, "confirmed": True})
        name_tab(addr, job.get("tab") or job["name"].replace("-", " ").capitalize())
    # A folder the agent has not trusted yet stops at a dialog with no status,
    # and the first message waits behind it. Say so instead of looking like it ran.
    hc("wait", addr, "--timeout", "45", check=False)
    info = hc("get", addr, check=False)
    status = (info.get("status") or {}).get("state")
    if not require_visible:
        record(job["name"], session, addr)
    if not require_visible and (status is None or (status == "idle" and info.get("turn", 0) == 0)):
        print(json.dumps({"session": session, "address": addr, "started": False,
                          "why": "agent is not working: probably a folder trust question. "
                                 f"Open it (hc attach {session}) and answer; the prompt is delivered once the folder is trusted, so do not resend it."}))
        sys.exit(2)
    if (args.wait or close) and status == "working":
        while True:
            state = hc("wait", addr, "--timeout", "600", check=False)
            status = state.get("status") or status
            if state.get("reason") != "timeout" and status != "working":
                break
    result = {"session": session, "address": addr, "started": True, "status": status}
    if close:
        result["closed"], result["outcome"] = close_if_ok(addr, outcome)
    print(json.dumps(result))


def outcome_file(name):
    return STATE / f"{name}.outcome"


def close_if_ok(addr, outcome):
    """Exit a finished session whose agent reported `ok`; leave anything else open.

    /exit rather than a kill, so the agent's own end-of-session hooks run.
    keep is turned off first, or Herdr would replace the exited agent with a shell.
    """
    text = outcome.read_text().strip() if outcome.exists() else ""
    line = text.splitlines()[0] if text else ""
    if not line.lower().startswith("ok"):
        return False, line or None
    hc("keep", addr, "--off", check=False)
    hc("send", addr, "/exit", check=False)
    for _ in range(180):  # the end-of-session hook may save and push first
        if hc("get", addr, check=False).get("state") != "live":
            break
        time.sleep(1)
    else:
        hc("kill", addr, check=False)
        time.sleep(2)
    hc("rm", addr, check=False)
    return True, line


def record(name, session, address):
    RUNS.parent.mkdir(parents=True, exist_ok=True)
    with RUNS.open("a") as f:
        f.write(json.dumps({"job": name, "session": session, "address": address, "ts": int(time.time())}) + "\n")


def last_runs():
    last = {}
    if RUNS.exists():
        for line in RUNS.read_text().splitlines():
            try:
                r = json.loads(line)
                last[r["job"]] = r
            except (ValueError, KeyError):
                pass
    return last


# ---- hooks ----------------------------------------------------------------

def python():
    """The interpreter schedules use: the system one on Linux (not a mise shim that can
    change under it), Homebrew's on the Mac (macOS's own is too old for tomllib)."""
    for fixed in (["/usr/bin/python3"] if LINUX else ["/opt/homebrew/bin/python3", "/usr/local/bin/python3"]):
        if os.path.exists(fixed):
            return fixed
    return sys.executable


def hook_script(hook, *args, timeout):
    return subprocess.run([python(), str(hook["script"]), *args], capture_output=True, text=True, timeout=timeout)


def check(args):
    hook = load(args.name)
    if hook["kind"] != "hook":
        die(f"{hook['name']} is a job; use `job run {hook['name']}`")
    # Paused: skip without running the check, so the first check after resuming catches up.
    if paused() and not args.force:
        print(json.dumps({"ok": True, "result": "paused", "triggered": 0}))
        return
    out = hook_script(hook, "check", timeout=600)
    sys.stdout.write(out.stdout)
    sys.stderr.write(out.stderr)
    sys.exit(out.returncode)


def hook_status(hook):
    row = {"name": hook["name"], "title": hook.get("title") or hook["name"].replace("-", " ").capitalize(),
           "interval": hook["interval"], "loaded": scheduler().loaded(hook["name"], "hook"),
           "last_check": None, "last_trigger": None, "error": None}
    try:
        out = hook_script(hook, "status", timeout=20)
        data = json.loads(out.stdout)
        if not data.get("ok"):
            raise ValueError(out.stderr.strip() or "status failed")
        first = (data.get("hooks") or [{}])[0]
        row["last_check"], row["last_trigger"] = first.get("last_check"), first.get("last_trigger")
    except (ValueError, OSError, TypeError, AttributeError, subprocess.TimeoutExpired) as exc:
        row["error"] = f"{hook['script'].name}: status answered badly ({exc})"
    return row


# ---- schedules ------------------------------------------------------------

def times_of(sched):
    return sched.get("times") or [f"{int(sched['hour']):02d}:{int(sched.get('minute', 0)):02d}"]


def next_run(sched, now=None):
    """Epoch seconds of the next scheduled start, in local time."""
    now = now or time.time()
    days = sched.get("weekdays")
    for ahead in range(8):
        day = time.localtime(now + ahead * 86400)
        if days and (day.tm_wday + 1) not in days:
            continue
        for t in sorted(times_of(sched)):
            h, m = (int(x) for x in t.split(":"))
            at = time.mktime((day.tm_year, day.tm_mon, day.tm_mday, h, m, 0, 0, 0, -1))
            if at > now:
                return int(at)
    return None


# Schedules always name the engine in ~/dotfiles, never the checkout that wrote them,
# so a schedule written from a worktree still works after the worktree is removed.
ENGINE = HOME / "dotfiles/herdr-app/jobs/job"


def command_for(item):
    """What the scheduler runs: `job run <name>` or `job check <name>`."""
    verb = "check" if item["kind"] == "hook" else "run"
    return [python(), str(ENGINE), verb, item["name"]]


def require_home_checkout():
    """Writing real schedules from a worktree would point them at code that's about to vanish."""
    if SCHEDULER != "none" and HERE.resolve() != ENGINE.parent.resolve():
        die(f"run this from ~/dotfiles, not {HERE.parent.parent}: schedules must use the engine in ~/dotfiles")


def require_schedule(item):
    if item["kind"] == "job" and not item.get("schedule"):
        raise DefError(f"{item['name']}: no [schedule] table (times = [\"07:00\"], optional weekdays 1-7 with 1 = Monday)")


class Launchd:
    """macOS: one LaunchAgent plist per job or hook."""

    def __init__(self, live=True):
        self.live = live  # False writes the files but never loads them (tests)

    @staticmethod
    def label(name, kind):
        return f"com.parker.{kind}.{name}"

    def paths(self, name, kind):
        return [LAUNCHD / f"{self.label(name, kind)}.plist"]

    def loaded(self, name, kind):
        return self.paths(name, kind)[0].exists()

    def installed(self):
        """(name, kind) of every schedule this engine wrote."""
        return [(p.stem.split(".", 3)[3], p.stem.split(".")[2]) for p in sorted(LAUNCHD.glob("com.parker.*.*.plist"))
                if p.stem.split(".")[2] in ("job", "hook")]

    def units(self, item):
        require_schedule(item)
        label = self.label(item["name"], item["kind"])
        log = HOME / "Library/Logs" / f"{label}.log"
        plist = {"Label": label, "ProgramArguments": command_for(item),
                 "EnvironmentVariables": {"PATH": PATH},
                 "StandardOutPath": str(log), "StandardErrorPath": str(log)}
        if item["kind"] == "hook":
            plist |= {"StartInterval": item["interval"], "RunAtLoad": True}
        else:
            sched, when = item["schedule"], []
            for t in times_of(sched):
                h, m = (int(x) for x in t.split(":"))
                for d in sched.get("weekdays") or [None]:
                    when.append({"Hour": h, "Minute": m} | ({"Weekday": d % 7} if d else {}))
            plist["StartCalendarInterval"] = when
        return {self.paths(item["name"], item["kind"])[0]: plistlib.dumps(plist)}

    def install(self, item):
        written = write_units(self.units(item))
        if self.live:
            subprocess.run(["launchctl", "unload", str(written[0])], capture_output=True)
            loaded = subprocess.run(["launchctl", "load", str(written[0])], capture_output=True, text=True)
            if loaded.returncode != 0:
                written[0].unlink(missing_ok=True)
                raise ScheduleError(f"launchctl couldn't load {written[0].name}: {loaded.stderr.strip()}")
        return written

    def activate(self, name, kind):
        """Load files already on disk (used to put back a schedule a failed rewrite removed)."""
        if self.live:
            subprocess.run(["launchctl", "load", str(self.paths(name, kind)[0])], capture_output=True)

    def uninstall(self, name, kind):
        paths = self.paths(name, kind)
        if self.live:
            subprocess.run(["launchctl", "unload", str(paths[0])], capture_output=True)
        for path in paths:
            path.unlink(missing_ok=True)
        return paths


class Systemd:
    """Linux: a oneshot service and a timer per job or hook, in the user's systemd."""
    DAYS = ["", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

    def __init__(self, live=True):
        self.live = live

    @staticmethod
    def unit(name, kind):
        return f"parker-{kind}-{name}"

    def paths(self, name, kind):
        base = SYSTEMD / self.unit(name, kind)
        return [base.with_suffix(".service"), base.with_suffix(".timer")]

    def loaded(self, name, kind):
        return self.paths(name, kind)[1].exists()

    def installed(self):
        found = []
        for p in sorted(SYSTEMD.glob("parker-*-*.timer")):
            _, kind, name = p.stem.split("-", 2)
            if kind in ("job", "hook"):
                found.append((name, kind))
        return found

    def units(self, item):
        require_schedule(item)
        service, timer = self.paths(item["name"], item["kind"])
        what = "hook check" if item["kind"] == "hook" else "job"
        exec_start = " ".join(systemd_arg(a) for a in command_for(item))
        # KillMode=process: the agent session belongs to herdr-core, so ending this
        # unit must not take down anything it started.
        service_body = (f"[Unit]\nDescription=Parker {what}: {item['name']}\n\n"
                        f"[Service]\nType=oneshot\nExecStart={exec_start}\n"
                        f"Environment={systemd_arg('PATH=' + PATH, exec_word=False)}\nTimeoutStartSec=infinity\nKillMode=process\n")
        if item["kind"] == "hook":
            when = f"OnActiveSec=10\nOnUnitActiveSec={item['interval']}\n"
        else:
            sched = item["schedule"]
            days = ",".join(self.DAYS[d] for d in sched.get("weekdays") or [])
            when = "".join(f"OnCalendar={days + ' ' if days else ''}*-*-* {t}:00\n" for t in times_of(sched))
            when += "Persistent=true\n"
        timer_body = (f"[Unit]\nDescription=Parker {what}: {item['name']}\n\n"
                      f"[Timer]\n{when}\n[Install]\nWantedBy=timers.target\n")
        return {service: service_body.encode(), timer: timer_body.encode()}

    def install(self, item):
        written = write_units(self.units(item))
        if self.live:
            unit = self.unit(item["name"], item["kind"])
            try:
                subprocess.run(["systemctl", "--user", "daemon-reload"], check=True, capture_output=True)
                subprocess.run(["systemctl", "--user", "enable", "--now", f"{unit}.timer"], check=True, capture_output=True)
            except subprocess.CalledProcessError as exc:
                # Don't leave files (or an enabled timer) that make it look turned on when it isn't.
                subprocess.run(["systemctl", "--user", "disable", "--now", f"{unit}.timer"], capture_output=True)
                for path in written:
                    path.unlink(missing_ok=True)
                subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
                raise ScheduleError(f"systemctl couldn't turn on {unit}.timer: {(exc.stderr or b'').decode().strip() or exc}")
        return written

    def activate(self, name, kind):
        if self.live:
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            subprocess.run(["systemctl", "--user", "enable", "--now", f"{self.unit(name, kind)}.timer"], capture_output=True)

    def uninstall(self, name, kind):
        if self.live:
            subprocess.run(["systemctl", "--user", "disable", "--now", f"{self.unit(name, kind)}.timer"], capture_output=True)
        paths = self.paths(name, kind)
        for path in paths:
            path.unlink(missing_ok=True)
        if self.live:
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        return paths


def systemd_arg(text, exec_word=True):
    """One ExecStart word (exec_word) or Environment assignment, escaped for systemd:
    % always doubled, $ doubled only in ExecStart (Environment doesn't expand it),
    quoted with \\ and \" escaped when it has a space, quote or backslash."""
    text = text.replace("%", "%%")
    if exec_word:
        text = text.replace("$", "$$")
    if any(c in text for c in ' "\\'):
        return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return text


def write_units(units):
    for path, body in units.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(body)
    return list(units)


def scheduler():
    """launchd on macOS, systemd on Linux. JOB_SCHEDULER=none writes files without loading
    them (tests); JOB_SCHEDULER_FORMAT then picks which kind of file."""
    if SCHEDULER == "none":
        fmt = os.environ.get("JOB_SCHEDULER_FORMAT") or ("systemd" if LINUX else "launchd")
        return {"launchd": Launchd, "systemd": Systemd}[fmt](live=False)
    return {"launchd": Launchd, "systemd": Systemd}[SCHEDULER]()


# ---- status ---------------------------------------------------------------

def job_status(job, last):
    sched = job.get("schedule")
    loaded = scheduler().loaded(job["name"], "job")
    row = {"name": job["name"], "error": None, "agent": job["agent"], "repo": job["repo"],
           "times": times_of(sched) if sched else [], "weekdays": (sched or {}).get("weekdays") or [],
           "next": next_run(sched) if sched else None, "loaded": loaded, "last": None}
    run_ = last.get(job["name"])
    if run_:
        info = hc("get", run_["session"], check=False)
        live = info.get("state") == "live"
        state = (info.get("status") or {}).get("state") if live else None
        row["last"] = {"ts": run_["ts"], "session": run_["session"], "address": info.get("address") if live else None,
                       "state": state or ("ended" if info.get("state") == "finished" else "gone" if not info.get("state") else "no status")}
    return row


def broken_row(item):
    """A definition that can't load still gets a row, so the panel shows why."""
    row = {"name": item["name"], "error": item["error"], "loaded": scheduler().loaded(item["name"], item["kind"])}
    if item["kind"] == "hook":
        return row | {"title": item["name"].replace("-", " ").capitalize(), "interval": 0, "last_check": None, "last_trigger": None}
    return row | {"agent": "", "repo": "", "times": [], "weekdays": [], "next": None, "last": None}


def status():
    last = last_runs()
    items = all_items()
    jobs = [broken_row(i) if "error" in i else job_status(i, last) for i in items if i["kind"] == "job"]
    hooks = [broken_row(i) if "error" in i else hook_status(i) for i in items if i["kind"] == "hook"]
    print(json.dumps({"ok": True, "machine": machine.name(), "paused": paused(), "jobs": jobs, "hooks": hooks}))


REFRESH_DRIFT, REFRESH_FAILED = 3, 4


def refresh(check_only):
    """Rewrite turned-on schedules that differ from what this engine would write.

    Exit 0 when everything matches (or was rewritten), 3 when --check found drift,
    4 when a schedule couldn't be rewritten. One broken item doesn't stop the rest."""
    if not check_only:
        require_home_checkout()
    sched, defs, drift, failed = scheduler(), definitions(), False, False
    for name, kind in sched.installed():
        if name not in defs:
            print(f"stale {kind} schedule '{name}': no definition on this machine (job uninstall {name})")
            drift = True
            continue
        try:
            item = load(name)
            if item["kind"] != kind:
                print(f"stale {kind} schedule '{name}': it's defined as a {item['kind']} now (job uninstall {name})")
                drift = True
                continue
            if kind == "job" and not item.get("schedule"):
                print(f"stale job schedule '{name}': the job has no [schedule] now (job uninstall {name})")
                drift = True
                continue
            units = sched.units(item)
        except DefError as exc:
            print(f"failed {kind} schedule '{name}': {exc} (it keeps its old schedule)", file=sys.stderr)
            failed = True
            continue
        if all(p.exists() and p.read_bytes() == body for p, body in units.items()):
            continue
        drift = True
        if check_only:
            print(f"would rewrite the {kind} schedule for {name}")
            continue
        old = {p: p.read_bytes() for p in units if p.exists()}
        try:
            sched.install(item)
            print(f"rewrote the {kind} schedule for {name}")
        except ScheduleError as exc:
            # Put the old schedule back rather than leave a job that was on turned off.
            write_units(old)
            sched.activate(name, kind)
            print(f"failed {kind} schedule '{name}': {exc} (its old schedule is back)", file=sys.stderr)
            failed = True
    sys.exit(REFRESH_FAILED if failed else REFRESH_DRIFT if check_only and drift else 0)


def describe(item):
    if item["kind"] == "hook":
        return f"every {item['interval'] // 60} min"
    s = item.get("schedule")
    if not s:
        return "manual"
    return ", ".join(times_of(s)) + (f" days {s['weekdays']}" if s.get("weekdays") else " daily")


# ---- main -----------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(prog="job", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    sub.add_parser("status")
    for c in ("pause", "resume"):
        sub.add_parser(c).add_argument("--by", help="who paused; resume --by only lifts that one's pause")
    r = sub.add_parser("run"); r.add_argument("name"); r.add_argument("--wait", action="store_true")
    r.add_argument("--force", action="store_true", help="run even while jobs are paused")
    c = sub.add_parser("check"); c.add_argument("name")
    c.add_argument("--force", action="store_true", help="check even while jobs are paused")
    for name in ("unit", "install", "uninstall"):
        sub.add_parser(name).add_argument("name")
    sub.add_parser("refresh").add_argument("--check", action="store_true", help="report, change nothing")
    args = p.parse_args()

    if args.cmd == "list":
        for item in all_items():
            if "error" in item:
                print(f"{item['name']:<24} {item['kind']:<5} broken: {item['error']}")
                continue
            where = item.get("repo") or str(item["script"])
            print(f"{item['name']:<24} {item['kind']:<5} {item.get('agent', ''):<7} {describe(item):<22} {where}")
    elif args.cmd == "status":
        status()
    elif args.cmd == "run":
        run(args)
    elif args.cmd == "check":
        check(args)
    elif args.cmd == "pause":
        PAUSED.parent.mkdir(parents=True, exist_ok=True)
        # An existing pause keeps its owner, so a demo never lifts a pause made by hand.
        if not paused():
            PAUSED.write_text(json.dumps({"ts": int(time.time())} | ({"by": args.by} if args.by else {})))
        print(json.dumps({"ok": True, "paused": paused()}))
    elif args.cmd == "resume":
        if not args.by or (paused() or {}).get("by") == args.by:
            PAUSED.unlink(missing_ok=True)
        print(json.dumps({"ok": True, "paused": paused()}))
    elif args.cmd == "refresh":
        refresh(args.check)
    elif args.cmd == "unit":
        for path, body in scheduler().units(load(args.name)).items():
            print(f"# {path}")
            sys.stdout.write(body.decode())
            print()
    elif args.cmd == "install":
        require_home_checkout()
        item = load(args.name)
        written = scheduler().install(item)
        print(json.dumps({"ok": True, "installed": [str(p) for p in written]}))
    elif args.cmd == "uninstall":
        # A definition that has been deleted can still be uninstalled by name.
        # Whatever is installed under this name goes, job or hook, even if the file changed kind or is gone.
        sched = scheduler()
        kinds = [k for k in ("job", "hook") if sched.loaded(args.name, k)]
        if not kinds:
            try:
                kinds = [raw(args.name)["kind"]]
            except DefError:
                kinds = ["job"]
        removed = [p for k in kinds for p in sched.uninstall(args.name, k)]
        print(json.dumps({"ok": True, "removed": [str(p) for p in removed]}))


if __name__ == "__main__":
    try:
        main()
    except (DefError, ScheduleError) as exc:
        die(str(exc))
