{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "space-sessions",
              "type": "block",
              "content": {
                "mod": "space-sessions"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "my-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "day-strip",
          "type": "block",
          "content": {
            "mod": "day-strip"
          },
          "size": {
            "px": 46
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "column",
          "children": [
            {
              "id": "meeting",
              "type": "block",
              "content": {
                "mod": "call-sheet"
              },
              "size": {
                "weight": 7
              },
              "min": 260,
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 10,
              "focus": {
                "border": {
                  "width": 1,
                  "color": "accent"
                }
              }
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-header"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              },
              "size": {
                "weight": 3
              },
              "min": 120
            }
          ],
          "padding": 8,
          "gap": 8,
          "floating": [
            {
              "id": "lock-in",
              "content": {
                "mod": "lock-in"
              },
              "edge": "top",
              "align": "center"
            }
          ]
        },
        {
          "id": "status-row",
          "type": "row",
          "children": [
            {
              "id": "glances",
              "type": "block",
              "content": {
                "mod": "glances"
              },
              "size": {
                "weight": 1
              },
              "min": 200
            },
            {
              "id": "usage-limits",
              "type": "block",
              "content": {
                "mod": "usage-limits"
              },
              "size": {
                "weight": 1
              },
              "min": 130
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "toast": "parker-toast"
}
