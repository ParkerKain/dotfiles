#!/bin/sh
# Runs frost.py with a Python that has Pillow: Homebrew's on the Mac, or uv's on
# Omarchy (whose system Python has none and can't take pip installs).
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"
here=$(dirname -- "$(realpath -- "$0")")
if python3 -c 'import PIL' 2>/dev/null; then
  exec python3 "$here/frost.py" "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project --with pillow python3 "$here/frost.py" "$@"
fi
echo "frost: needs Pillow (python3 -m pip install pillow) or uv" >&2
exit 1
