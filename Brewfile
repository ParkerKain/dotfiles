# Brewfile
# Install everything with: brew bundle

# Core setup
brew "stow"                  # dotfile symlinking

# Shell & prompt
brew "starship"
brew "fish"
brew "direnv"

# Terminal utilities
brew "eza"                   # better ls (alias: l)
brew "bat"                   # better cat (Catppuccin themes in .config/bat)
brew "fzf"
brew "ripgrep"               # rg — used by fzf and general search
brew "gum"                   # required by nwt function

# Editors
brew "neovim"
brew "tree-sitter-cli"

# Neovim LSPs
brew "lua-language-server"
brew "pyright"

# Multiplexers
brew "tmux"
brew "tmuxinator"

# Git tools
brew "gh"                    # GitHub CLI
brew "lazygit"               # alias: lg
brew "lazydocker"            # alias: ld


# Languages & runtimes
brew "nvm"                   # Node — also source manually, see note below
brew "uv"                    # Python package manager
brew "rustup"                # Rust — run `rustup-init` after install

# Taps
tap "nikitabobko/tap"

# Terminal emulators
cask "ghostty"
cask "alacritty"
# Window manager
cask "nikitabobko/tap/aerospace"

# Fonts
cask "font-iosevka-nerd-font"
