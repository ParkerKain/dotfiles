# A custom .stow-local-ignore REPLACES stow's built-in default ignore list,
# so the git patterns below must be re-listed or .git/.gitignore would get
# symlinked into the target directory.
\.git
\.gitignore

# Repo-only documentation. This CLAUDE.md documents THIS repo and must NOT be
# stowed to ~ (where it would become a home-level instruction file). The real
# global lives at .claude/CLAUDE.md, which IS stowed. See CLAUDE.md for details.
^/CLAUDE\.md
