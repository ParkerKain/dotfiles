#!/usr/bin/env bash
# claude-waiting-count - print "◍ N waiting " when N Claude panes await input.
set -u
dir="${CLAUDE_MAP_STATE_DIR:-$HOME/.claude/tmux-state}"
[ -d "$dir" ] || exit 0
n=0
for f in "$dir"/*; do
  [ -e "$f" ] || continue
  case "$(basename "$f")" in .tmp.*) continue ;; esac
  case "$(cut -f2 "$f" 2>/dev/null)" in
    waiting-permission|waiting-input) n=$(( n + 1 )) ;;
  esac
done
[ "$n" -gt 0 ] && printf '◍ %d waiting ' "$n"
exit 0
