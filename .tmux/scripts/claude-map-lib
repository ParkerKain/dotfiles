#!/usr/bin/env bash
# claude-map-lib - shared pane enumeration + status resolution for
# claude-map and claude-map-statusline. Sourced, not executed directly.

: "${CLAUDE_MAP_STATE_DIR:=$HOME/.claude/tmux-state}"
CLAUDE_MAP_VERSION_RE='^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$'
# True-color rose-pine moon values, matching claude-map-statusline exactly
# (LOVE/GOLD/FOAM/MUTED) so the minimap and status-bar chips never diverge.
CLAUDE_MAP_COLOR_WAITING_PERMISSION=$'\033[38;2;235;111;146m'   # love
CLAUDE_MAP_COLOR_WAITING_INPUT=$'\033[38;2;246;193;119m'        # gold
CLAUDE_MAP_COLOR_WORKING=$'\033[38;2;156;207;216m'              # foam
CLAUDE_MAP_COLOR_IDLE=$'\033[38;2;110;106;134m'                 # muted
CLAUDE_MAP_COLOR_RESET=$'\033[0m'

# claude_map_tool_tag <tool> -> single-char display tag.
claude_map_tool_tag() {
  case "$1" in
    claude) printf 'c' ;;
    codex)  printf 'x' ;;
    pi)     printf 'π' ;;
    *)      printf '?' ;;
  esac
}

# claude_map_is_pi_pane <pane_current_command> <pane_title> <window_name>
# -> true when the pane is Pi. Depending on how Pi was launched, tmux may
# report its command as `pi` or as the underlying `node` process. Pi session
# titles are user-controlled, so the Pi window name is the reliable fallback
# when the lifecycle extension has not written a state file yet.
claude_map_is_pi_pane() {
  [ "$1" = "pi" ] && return 0
  [ "$1" = "node" ] || return 1
  case "$2" in
    π*|Pi) return 0 ;;
  esac
  case "$3" in
    [Pp][Ii]|[Pp][Ii]-*) return 0 ;;
    *)                   return 1 ;;
  esac
}

# claude_map_scan_raw <rows_file>
# Writes one line per live Claude, Codex, or Pi pane to <rows_file>, sorted
# worst-status-first:
#   sort_key<TAB>status<TAB>tool<TAB>icon<TAB>session<TAB>title<TAB>age<TAB>window<TAB>pane<TAB>pane_id<TAB>named
# window/pane are the tmux window and pane indices (e.g. 2, 1) - needed to
# tell apart multiple Claude panes that share the same session name. `named` is
# 1 when the agent supplied a title and 0 when the fallback identity is used.
# Prunes stale state files (pane no longer live) as a side effect.
claude_map_scan_raw() {
  local rows_file="$1"
  local sep panes live now
  sep="$(printf '\037')"
  now="$(date +%s)"
  panes="$(mktemp)"; live="$(mktemp)"

  tmux list-panes -a -F \
    "#{pane_id}${sep}#{session_name}${sep}#{window_index}${sep}#{pane_index}${sep}#{pane_current_command}${sep}#{pane_title}${sep}#{pane_current_path}${sep}#{window_name}" \
    > "$panes"
  cut -d "$sep" -f1 "$panes" > "$live"

  if [ -d "$CLAUDE_MAP_STATE_DIR" ]; then
    for f in "$CLAUDE_MAP_STATE_DIR"/*; do
      [ -e "$f" ] || continue
      b="$(basename "$f")"
      case "$b" in .tmp.*) continue ;; esac
      grep -qx "$b" "$live" || rm -f "$f"
    done
  fi

  : > "$rows_file"
  while IFS="$sep" read -r pid sess win pane cmd title path window_name; do
    status=""; ts=0; summary=""; tool=""
    sf="$CLAUDE_MAP_STATE_DIR/$pid"
    if [ -f "$sf" ]; then
      IFS=$'\t' read -r tool status ts summary < "$sf" || true
      # The tool that wrote this file may have exited without its SessionEnd
      # hook firing (Ctrl-C, crash, non-standard exit path) while the pane
      # itself lives on running something else. Pruning-by-live-pane-id alone
      # can't catch that, so also drop the file if the pane's current command
      # no longer matches the tool it claims to be.
      case "$tool" in
        codex)  printf '%s' "$cmd" | grep -q '^codex$' || { rm -f "$sf"; status=""; tool=""; } ;;
        claude) printf '%s' "$cmd" | grep -Eq "$CLAUDE_MAP_VERSION_RE" || { rm -f "$sf"; status=""; tool=""; } ;;
        pi)     printf '%s' "$cmd" | grep -qE '^(pi|node)$' || { rm -f "$sf"; status=""; tool=""; } ;;
      esac
      [ -n "${ts:-}" ] || ts=0
      printf '%s' "$ts" | grep -Eq '^[0-9]+$' || ts=0
    fi
    if [ -n "$status" ]; then
      : # state file was valid and current; keep its status.
    elif printf '%s' "$cmd" | grep -Eq "$CLAUDE_MAP_VERSION_RE"; then
      case "$title" in
        "✳"*) status=idle ;;
        *)    status=working ;;
      esac
      summary="$(basename "$path")"
      tool=claude
    elif [ "$cmd" = codex ]; then
      # Codex has no reliable title convention; report present/unknown as idle
      # until its hooks fire and record real status.
      status=idle
      summary="$(basename "$path")"
      tool=codex
    elif claude_map_is_pi_pane "$cmd" "$title" "$window_name"; then
      # Pi can appear as `node` in tmux when its lifecycle state file is
      # missing. Report idle until the extension writes a current status.
      status=idle
      summary="$(basename "$path")"
      tool=pi
    fi
    [ -n "$status" ] || continue
    [ -n "$tool" ] || tool="?"

    case "$status" in
      waiting-permission) sk=0; icon="⏳" ;;
      waiting-input)      sk=1; icon="⏳" ;;
      approval-pending)   sk=2; icon="⠿" ;;
      idle)               sk=3; icon="✳" ;;
      working)            sk=4; icon="⠿" ;;
      *)                  sk=5; icon=" " ;;
    esac

    age="-"
    if [ "$ts" -gt 0 ]; then
      d=$(( now - ts ))
      if   [ "$d" -lt 60 ];   then age="${d}s"
      elif [ "$d" -lt 3600 ]; then age="$(( d / 60 ))m"
      else                         age="$(( d / 3600 ))h"
      fi
    fi

    slabel="$sess"
    [ "${#slabel}" -gt 20 ] && slabel="${slabel:0:19}~"

    # Agent titles are the useful identity when present. Strip the status/tool
    # prefix that Claude and Pi put in pane_title, but keep the original title
    # around long enough to distinguish a real name from the default Pi title.
    named=0
    case "$title" in
      "✳ "*)  ctitle="${title#✳ }"; named=1 ;;
      "⠿ "*)  ctitle="${title#⠿ }"; named=1 ;;
      "⏳ "*) ctitle="${title#⏳ }"; named=1 ;;
      "✳"|"⠿"|"⏳"|"π") ctitle="" ;;
      "π - "*) ctitle="${title#π - }" ;;
      "π "*)   ctitle="${title#π }" ;;
      [!A-Za-z0-9]*) ctitle="${title#* }"; named=1 ;;
      "")             ctitle="" ;;
      *)              ctitle="$title"; named=1 ;;
    esac

    # Pi's default pane title is `π - <directory>`, not a user-supplied name.
    # Only Claude and Pi titles should replace the tmux-coordinate fallback.
    case "$tool" in
      claude|pi) ;;
      *)          named=0 ;;
    esac

    [ -n "$ctitle" ] || ctitle="$(basename "$path")"
    [ "${#ctitle}" -gt 30 ] && ctitle="${ctitle:0:29}~"

    printf '%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$sk" "$status" "$tool" "$icon" "$slabel" "$ctitle" "$age" "$win" "$pane" "$pid" "$named" >> "$rows_file"
  done < "$panes"

  sort -n -o "$rows_file" "$rows_file"
  rm -f "$panes" "$live"
}

# claude_map_scan <rows_file>
# Writes one line per live Claude pane to <rows_file>, sorted worst-status-first:
#   sort_key<TAB>status<TAB>rendered<TAB>pane_id
# `rendered` is ANSI-colored, fixed-width text for terminal display (fzf, etc).
claude_map_scan() {
  local rows_file="$1"
  local raw color rendered
  raw="$(mktemp)"
  claude_map_scan_raw "$raw"

  : > "$rows_file"
  while IFS=$'\t' read -r sk status tool icon slabel ctitle age win pane pid named; do
    case "$status" in
      waiting-permission) color="$CLAUDE_MAP_COLOR_WAITING_PERMISSION" ;;
      waiting-input)      color="$CLAUDE_MAP_COLOR_WAITING_INPUT" ;;
      idle)                color="$CLAUDE_MAP_COLOR_IDLE" ;;
      working)             color="$CLAUDE_MAP_COLOR_WORKING" ;;
      *)                   color="" ;;
    esac

    slabel="$(claude_map_tool_tag "$tool")·${slabel}:${win}.${pane}"

    rendered="$(printf '%s%s  %-25s %-30s %-18s %-5s%s' \
      "$color" "$icon" "$slabel" "$ctitle" "$status" "$age" "$CLAUDE_MAP_COLOR_RESET")"

    printf '%d\t%s\t%s\t%s\n' "$sk" "$status" "$rendered" "$pid" >> "$rows_file"
  done < "$raw"

  rm -f "$raw"
}
